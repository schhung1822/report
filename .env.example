# Copy this file to .env.local and fill in your own values.

# Email or username used to sign in (case-insensitive).
AUTH_USERNAME=admin@example.com

# Password for that account.
AUTH_PASSWORD=change-me

# Random string (at least 32 characters) used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# API key from https://kie.ai (used for the AI report analysis). Never expose it to the browser.
KIE_API_KEY=

# Lark (Larksuite) bot used to post report images to a group chat.
# Create a custom app at https://open.larksuite.com/app, enable the Bot capability, grant the
# "im:resource" and "im:message:send_as_bot" scopes, publish it, then add the bot to the target group.
LARK_APP_ID=
LARK_APP_SECRET=
# The group's chat_id (starts with "oc_").
LARK_CHAT_ID=
# Optional: use https://open.feishu.cn for Feishu (China). Defaults to https://open.larksuite.com.
# LARK_BASE_URL=
