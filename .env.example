# Copy this file to .env.local and fill in your own values.

# Email or username used to sign in (case-insensitive).
AUTH_USERNAME=admin@example.com

# Password for that account.
AUTH_PASSWORD=change-me

# Random string (at least 32 characters) used to sign the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# API key from https://kie.ai (used for the AI report analysis). Never expose it to the browser.
KIE_API_KEY=

# Lark (Larksuite) bot used to post report images and PDF files to a group chat (same scopes cover both).
# Create a custom app at https://open.larksuite.com/app, enable the Bot capability, grant the
# "im:resource" and "im:message:send_as_bot" scopes, publish it, then add the bot to the target group.
LARK_APP_ID=
LARK_APP_SECRET=
# The group's chat_id (starts with "oc_").
LARK_CHAT_ID=
# Optional: use https://open.feishu.cn for Feishu (China). Defaults to https://open.larksuite.com.
# LARK_BASE_URL=

# External API: POST /api/external/daily-reports creates the Hiệu suất / Quản trị Việt / Quản trị Phil reports of a day and posts
# their PDFs to the Lark group. Callers send this key as "Authorization: Bearer <key>" (or the "x-api-key" header).
# At least 24 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the API is switched off.
EXTERNAL_API_KEY=
# The API draws the PDFs in a headless Chrome installed on the server (a VPS: see DEPLOY-VPS.md; managed hosting cannot run it).
# On Ubuntu install Google Chrome from the .deb, NOT `apt install chromium` (that is a snap stub).
# Optional: path of the browser. Found automatically in the usual places (/usr/bin/chromium, google-chrome, Chrome/Edge on Windows).
# CHROME_PATH=
# Optional: address Chrome uses to reach this app. Defaults to http://127.0.0.1:$PORT (3000 when PORT is not set).
# INTERNAL_BASE_URL=

# Pancake POS MCP (https://pos.pancake.vn/developers/mcp/connect). Server-side only, never expose it to the browser.
# Prefer an ACCOUNT-level API key: it is limited to what your user can do in each shop.
# (A shop-level key from Configuration > Applications > Webhook/API also works but has full access to that shop.)
PANCAKE_POS_API_KEY=
# One key per shop? Add more variables named PANCAKE_POS_API_KEY_<SUFFIX> (e.g. PANCAKE_POS_API_KEY_PHIL).
# Shops from all keys are listed together and each shop is queried with the key that can see it.
# PANCAKE_POS_API_KEY_PHIL=
# Optional: shop to use when the account has several. Leave empty to pick it on the report pages.
# PANCAKE_SHOP_ID=
# Philippines shops: PANCAKE_SHOP_ID_PHIL, PANCAKE_SHOP_ID_PHIL2, ... (the shop id of each). A shop listed here is always treated as a
# peso (PHP) shop, so two Philippines shops are costed the same way and merged into one report. PANCAKE_PHP_SHOP_IDS takes a comma list.
# PANCAKE_SHOP_ID_PHIL=
# PANCAKE_SHOP_ID_PHIL2=
# Philippines shops whose cost of goods is the cost of each product in the POS (not the average cost per kind of goods typed on the cost
# page), comma separated ids. Example: the GIP 273 - RINO shop.
# PANCAKE_POS_COST_SHOP_IDS=
# Optional: override the MCP endpoint (default https://mcp-pos.pancake.biz/mcp).
# PANCAKE_POS_MCP_URL=
# Optional: timezone Pancake uses to bucket days, as a UTC offset in hours. Defaults to 7 (verified for VN and PH shops).
# PANCAKE_UTC_OFFSET_HOURS=
# Optional: regex (case-insensitive) that marks an order source as the Zalo channel in the Vietnam report.
# Matches the source's own name or its parent's name; every other source counts as Page. Default: zalo
# PANCAKE_ZALO_SOURCE_PATTERN=

# MySQL for fixed costs (page "Chi phí cố định"). Run database/schema.sql on the database first.
# Either a single URL...
MYSQL_URL=
# ...or separate settings (used only when MYSQL_URL is empty):
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# TLS for hosted MySQL. true = encrypt AND verify the server certificate.
# If the server uses a SELF-SIGNED certificate (error HANDSHAKE_SSL_ERROR / self-signed certificate in certificate chain):
#   - recommended: MYSQL_SSL=true plus MYSQL_SSL_CA=<path to the server ca.pem, or the PEM text>
#   - quick but weaker: MYSQL_SSL=no-verify (encrypted, but the server is not authenticated)
# MYSQL_SSL=true
# MYSQL_SSL_CA=
